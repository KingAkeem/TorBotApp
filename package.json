{
  "name": "torbot-app",
  "version": "1.0.0",
  "description": "Desktop interface for TorBot powered by the GoTor crawl API",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "setup:gotor": "node scripts/build-gotor.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "css-loader": "^7.1.2",
    "electron": "39.8.5",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
